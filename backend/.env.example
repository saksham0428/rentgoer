PORT=5000
NODE_ENV=development
DATABASE_URL="postgresql://user:password@localhost:5432/rentgoer"
DIRECT_URL="postgresql://user:password@localhost:5432/rentgoer"
JWT_SECRET="your_super_secret_jwt_key_here"
# Rollout Stage A: "false" (verify sessions, issue legacy tokens during rolling deploy)
# Rollout Stage B: "true" (issue session-aware tokens once 100% of instances run new code)
ENABLE_SESSION_ISSUANCE="false"
# Set to an explicit UTC timestamp (Stage B activation timestamp + 7 days)
LEGACY_TOKEN_CUTOFF_DATE="2026-10-28T00:00:00.000Z"
FRONTEND_URL="http://localhost:3000"
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
SUPABASE_STORAGE_BUCKET="property-images"

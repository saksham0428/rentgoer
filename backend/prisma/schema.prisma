generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                  String          @id @default(uuid())
  name                String
  email               String          @unique
  passwordHash        String
  role                Role            @default(TENANT)
  phone               String?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  ownerConversations  Conversation[]  @relation("OwnerConversations")
  tenantConversations Conversation[]  @relation("TenantConversations")
  favorites           Favorite[]
  sentMessages        Message[]       @relation("SentMessages")
  notifications       Notification[]
  properties          Property[]      @relation("PropertyOwner")
  rentalRequests      RentalRequest[] @relation("TenantRequests")
  tenantReviews       Review[]        @relation("TenantReviews")
  reports             Report[]        @relation("UserReports")

  // Milestone 14 Verification fields
  isVerified            Boolean               @default(false)
  verifiedAt            DateTime?
  verifiedById          String?
  verifiedBy            User?                 @relation("AdminVerifiedUsers", fields: [verifiedById], references: [id])
  verifiedUsers         User[]                @relation("AdminVerifiedUsers")
  verifiedProperties    Property[]            @relation("AdminVerifiedProperties")
  ownedVerifications    VerificationRequest[] @relation("OwnerVerificationRequests")
  reviewedVerifications VerificationRequest[] @relation("AdminReviewedVerificationRequests")
}

model Property {
  id              String          @id @default(uuid())
  ownerId         String
  title           String
  description     String
  rent            Float
  securityDeposit Float
  city            String
  locality        String
  address         String
  latitude        Float?
  longitude       Float?
  bedrooms        Int
  bathrooms       Int
  propertyType    PropertyType
  furnishedStatus FurnishedStatus
  availableFrom   DateTime
  isAvailable     Boolean         @default(true)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  conversations   Conversation[]
  favorites       Favorite[]
  owner           User            @relation("PropertyOwner", fields: [ownerId], references: [id])
  images          PropertyImage[]
  rentalRequests  RentalRequest[]
  reviews         Review[]

  // Milestone 14 Verification fields
  isVerified           Boolean               @default(false)
  verifiedAt           DateTime?
  verifiedById         String?
  verifiedBy           User?                 @relation("AdminVerifiedProperties", fields: [verifiedById], references: [id])
  verificationRequests VerificationRequest[]

  @@index([city, locality])
  @@index([ownerId])
}

model PropertyImage {
  id         String   @id @default(uuid())
  propertyId String
  url        String
  publicId   String
  createdAt  DateTime @default(now())
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
}

model Favorite {
  id         String   @id @default(uuid())
  userId     String
  propertyId String
  createdAt  DateTime @default(now())
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, propertyId])
  @@index([userId])
  @@index([propertyId])
}

model RentalRequest {
  id           String        @id @default(uuid())
  propertyId   String
  tenantId     String
  message      String?
  status       RequestStatus @default(PENDING)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  conversation Conversation?
  review       Review?
  property     Property      @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  tenant       User          @relation("TenantRequests", fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@index([tenantId])
}

model Conversation {
  id              String        @id @default(uuid())
  rentalRequestId String        @unique
  propertyId      String
  tenantId        String
  ownerId         String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  owner           User          @relation("OwnerConversations", fields: [ownerId], references: [id], onDelete: Cascade)
  property        Property      @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  rentalRequest   RentalRequest @relation(fields: [rentalRequestId], references: [id], onDelete: Cascade)
  tenant          User          @relation("TenantConversations", fields: [tenantId], references: [id], onDelete: Cascade)
  messages        Message[]

  @@index([tenantId])
  @@index([ownerId])
  @@index([propertyId])
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  senderId       String
  content        String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  readAt         DateTime?
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([senderId])
  @@index([createdAt])
}

model Notification {
  id          String           @id @default(uuid())
  userId      String
  type        NotificationType
  title       String
  message     String
  isRead      Boolean          @default(false)
  readAt      DateTime?
  referenceId String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
}

enum NotificationType {
  RENTAL_REQUEST
  REQUEST_ACCEPTED
  REQUEST_REJECTED
  CHAT_MESSAGE
}

enum Role {
  TENANT
  OWNER
  ADMIN
}

enum PropertyType {
  APARTMENT
  HOUSE
  ROOM
  PG
  STUDIO
}

enum FurnishedStatus {
  FURNISHED
  SEMI_FURNISHED
  UNFURNISHED
}

enum RequestStatus {
  COMPLETED
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
}

model Review {
  id              String   @id @default(uuid())
  rentalRequestId String   @unique
  propertyId      String
  tenantId        String
  rating          Int
  title           String?
  comment         String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  rentalRequest RentalRequest @relation(fields: [rentalRequestId], references: [id], onDelete: Restrict)
  property      Property      @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  tenant        User          @relation("TenantReviews", fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@index([tenantId])
}

enum ReportTargetType {
  PROPERTY
  USER
  MESSAGE
}

enum ReportStatus {
  OPEN
  REVIEWING
  RESOLVED
  DISMISSED
}

enum ReportReason {
  FRAUD
  SCAM
  FAKE_LISTING
  INAPPROPRIATE_CONTENT
  HARASSMENT
  SPAM
  MISLEADING_INFORMATION
  SAFETY_CONCERN
  OTHER
}

model Report {
  id            String           @id @default(uuid())
  reporterId    String
  targetType    ReportTargetType
  targetId      String
  reason        ReportReason
  description   String
  status        ReportStatus     @default(OPEN)
  moderatorNote String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  reporter User @relation("UserReports", fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([reporterId])
  @@index([targetType, targetId])
  @@index([status])
  @@index([createdAt])
}

// Milestone 14 Verification models
model VerificationRequest {
  id              String             @id @default(uuid())
  type            VerificationType
  ownerId         String
  propertyId      String?
  status          VerificationStatus @default(PENDING)
  submittedAt     DateTime           @default(now())
  reviewedAt      DateTime?
  reviewedById    String?
  rejectionReason String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  owner      User      @relation("OwnerVerificationRequests", fields: [ownerId], references: [id], onDelete: Cascade)
  property   Property? @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  reviewedBy User?     @relation("AdminReviewedVerificationRequests", fields: [reviewedById], references: [id])

  @@index([type])
  @@index([status])
  @@index([ownerId])
  @@index([propertyId])
  @@index([submittedAt])
}

enum VerificationType {
  OWNER
  PROPERTY
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

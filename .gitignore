# Root .gitignore for RentGoer Project

# Ignore environment variables
.env
.env.*
!.env.example

# Ignore dependency directories
node_modules/
frontend/node_modules/
backend/node_modules/

# Ignore build outputs
dist/
build/
frontend/.next/
backend/dist/

# Ignore logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Ignore IDE / OS files
.DS_Store
.idea/
.vscode/
*.swp
